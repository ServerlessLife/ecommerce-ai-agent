# Dependencies
node_modules/

# Build outputs
dist/

# AgentCore Runtime ZIP staging dir — regenerated by agentcore/scripts/
# package.ts, zipped as a CDK S3 asset by infra/lib/AgentCoreStack.ts
agentcore/agentcore-package/

# LambdaWeb package staging dirs — regenerated by lambda-web/scripts/
# package.ts, zipped and uploaded to the packages bucket by
# infra/lib/AgentLambdaWebStack.ts
lambda-web/lambda-web-package/

# CDK
infra/cdk.out/
infra/cdk.context.json

# Deploy outputs — the demo deploy writes cdk-outputs.json, each cost-test
# environment its own cdk-outputs-<environment>.json
infra/cdk-outputs.json
infra/cdk-outputs-*.json

# Transcripts
transcripts/
